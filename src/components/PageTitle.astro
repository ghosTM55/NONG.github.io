---
interface Props {
  number: string;
  label: string;
  title: string;
}

const { number, label, title } = Astro.props;
---

<div class="page-title">
  <p class="page-title__eyebrow"><span aria-hidden="true">{number} / </span>{label}</p>
  <h1>{title}</h1>
</div>

<style>
  .page-title { min-width: 0; }
  .page-title__eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    line-height: 1.6;
    text-transform: uppercase;
  }
  .page-title h1 {
    margin: 18px 0 0;
    color: var(--gold);
    font-size: clamp(56px, 8.4vw, 128px);
    font-weight: 680;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  @media (max-width: 680px) {
    .page-title__eyebrow { font-size: 10px; }
    .page-title h1 { font-size: clamp(44px, 11.8vw, 80px); }
  }
</style>
