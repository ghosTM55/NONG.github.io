---
import { indexItems } from "../content/home";
import "../styles/navigation-mark.css";

interface Props { kind: "left" | "right" | "index"; }
const { kind } = Astro.props;
const arrow = kind === "left" ? "M108 32H6M34 4 6 32l28 28" : "M4 32h102M78 4l28 28-28 28";
---

<span class:list={["navigation-mark", `navigation-mark--${kind}`]} aria-hidden="true">
  {kind === "index" ? (
    indexItems.map((_, index) => <span class:list={["navigation-mark__leaf", { "navigation-mark__leaf--active": index === Math.floor(indexItems.length / 2) }]} style={`--leaf: ${index - (indexItems.length - 1) / 2}`} />)
  ) : (
    <>
      <svg viewBox="0 0 112 64"><path d={arrow} /></svg>
      <svg viewBox="0 0 112 64"><path d={arrow} /></svg>
    </>
  )}
</span>
