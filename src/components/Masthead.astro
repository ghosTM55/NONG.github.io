---
import { localizedPath, type Locale } from "../content/home";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copyEmailLabel = locale === "zh" ? "复制邮箱地址" : "Copy email address";
const copyEmailMessage = locale === "zh" ? "邮箱地址已复制" : "EMAIL ADDRESS COPIED";
const copyEmailError = locale === "zh" ? "复制失败" : "COPY FAILED";
const isDemo = Astro.url.pathname.replace(/^\/zh(?=\/)/, "").startsWith("/demo/");
---

<header class="masthead" data-site-masthead>
  <div class="masthead__identity">
    <a class="masthead__brand" href={localizedPath("/", locale)} aria-label={locale === "zh" ? "NONG Studio 首页" : "NONG Studio home"}>NONG STUDIO</a>
    <p class="masthead__fields">
      <span>CULTURE</span>
      <span class="masthead__fields-separator" aria-hidden="true">•</span>
      <span>ENTERTAINMENT</span>
      <span class="masthead__fields-separator" aria-hidden="true">•</span>
      <span>TECHNOLOGY</span>
    </p>
  </div>
  <button
    class="index-trigger"
    id="index-trigger"
    type="button"
    aria-label="Open index"
    aria-controls="index-panel"
    aria-expanded="false"
    data-index-trigger
    data-index-nav-trigger
  >
    <span class="index-trigger__label">INDEX</span>
    <span class="menu-glyph index-trigger__menu-icon" aria-hidden="true"></span>
  </button>

  <div class="masthead__utilities">
    <button
      class="masthead__email-copy"
      type="button"
      aria-label={copyEmailLabel}
      data-copy-email
      data-email="contact@nong.studio"
      data-copy-message={copyEmailMessage}
      data-copy-error={copyEmailError}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3.5 5.5h17v13h-17z" />
        <path d="m4.5 7 7.5 6 7.5-6" />
      </svg>
      <span class="masthead__email-feedback" role="status" aria-live="polite" data-copy-email-status></span>
    </button>
    <a
      class="masthead__demo"
      href={localizedPath("/demo/", locale)}
      aria-label={locale === "zh" ? "浏览 Demo" : "Explore demos"}
      aria-current={isDemo ? "true" : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 3.5H3.5V8M16 3.5h4.5V8M20.5 16v4.5H16M8 20.5H3.5V16" />
        <path d="m9 7 8 5-8 5Z" />
      </svg>
      <span class="masthead__demo-label" aria-hidden="true">DEMO</span>
    </a>
  </div>
</header>
